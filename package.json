{
  "name": "audible-library-extractor",
  "version": "0.2.14",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "─────── dev / build ───────": "true",
    "dev": "development=true yarn vite",
    "dev2": "yarn vite build --watch",
    "build": "gallerySingleFile=true yarn vite build && wallpaperSingleFile=true yarn vite build && yarn vite build && node zipper.js",
    "build1": "yarn vite build",
    "preview": "yarn vite preview --port 4173",
    "─────── shuffle build ───────": "true",
    "shuffle-build": "standaloneShuffle=1 yarn vite build --watch",
    "─────── ghpages test server ───────": "true",
    "ghpages": "node gh-pages-test/unzip-gallery.js && node gh-pages-test/server.js",
    "ghpages:serve": "node gh-pages-test/server.js",
    "ghpages:watch": "node gh-pages-test/server.js --watch",
    "ghpages:fresh": "node gh-pages-test/unzip-gallery.js && node gh-pages-test/server.js --fresh",
    "ghpages:unzip": "node gh-pages-test/unzip-gallery.js",
    "ghpages:shuffle-test": "trap 'kill 0' INT TERM EXIT; yarn shuffle-build & yarn ghpages:watch & wait",
    "─────── utils ───────": "true",
    "clean-install": "rm -rf node_modules yarn.lock && yarn install",
    "backup-lock": "cp yarn.lock yarn.lock.backup"
  },
  "dependencies": {
    "@crxjs/vite-plugin": "^2.5.0",
    "@date-fns/utc": "^2.1.1",
    "@meforma/vue-toaster": "^1.3.0",
    "@panzoom/panzoom": "^4.5.1",
    "@splidejs/vue-splide": "^0.6.12",
    "@supabase/supabase-js": "^2.104.1",
    "@tanstack/vue-virtual": "^3.13.29",
    "@vueform/multiselect": "^2.5.6",
    "async-es": "^3.2.4",
    "axios": "^1.17.0",
    "axios-rate-limit": "^1.3.0",
    "axios-retry": "^3.3.1",
    "bulma": "^0.9.4",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.9",
    "domurl": "^2.3.4",
    "downloadjs": "^1.4.7",
    "fflate": "^0.8.2",
    "fitty": "^2.3.6",
    "fuse.js": "^6.6.2",
    "howler": "^2.2.3",
    "ios-haptics": "^0.1.5",
    "jquery": "^4.0.0",
    "lodash": "^4.17.21",
    "minisearch": "^7.2.0",
    "mitt": "^3.0.0",
    "modern-screenshot": "^4.7.0",
    "normalize.css": "^8.0.1",
    "octokit": "^5.0.5",
    "smoothscroll-polyfill": "^0.4.4",
    "vite-plugin-dynamic-import": "^1.6.0",
    "vite-plugin-package-version": "^1.1.0",
    "vue": "^3.4.21",
    "vue-click-outside-element": "^3.1.2",
    "vue-contenteditable": "^4.1.0",
    "vue-dragscroll": "^4.0.5",
    "vue-router": "^4.1.5",
    "vue-slider-component": "^4.1.0-beta.4",
    "vue-tippy": "^6.0.0-alpha.65",
    "vue3-moveable": "^0.26.1",
    "vue3-shortkey": "https://github.com/BlazL/vue3-shortkey",
    "vue3-touch-events": "^4.1.2",
    "vuedraggable": "^4.1.0",
    "vuex": "^4.0.2",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.484",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "naive-ui": "^2.40.4",
    "picocolors": "^1.1.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-node-globals": "^1.4.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.89.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^0.28.0",
    "vfonts": "^0.0.3",
    "vite": "^6.4.2",
    "vite-plugin-ejs": "^1.7.0",
    "vite-plugin-singlefile": "^2.1.0",
    "vite-plugin-static-copy": "^2.2.0",
    "zip-a-folder": "^3.1.8"
  }
}
